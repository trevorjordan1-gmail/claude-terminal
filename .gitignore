# Audit output snapshots — contain hostnames, SSH aliases, project names.
# Never commit these.
os-audit*/
*.tar.gz

# Maintainer's local agent context — references private infrastructure.
CLAUDE.md

# Editor / OS noise
*.swp
.DS_Store

# Local-only docs — internal infrastructure detail (AWS accounts, hostnames,
# staff IDs). Never commit anything under here.
docs/internal/

# aws/ platform — tenant identity is PRIVATE, only templates are committed
aws/tenants.json
aws/terraform/*.tfvars
aws/terraform/backend.hcl
aws/terraform/.terraform*
aws/terraform/terraform.tfstate*
DCV-MODE-REQUEST.md

# Python bytecode — regenerated by every test run, never source
__pycache__/
*.pyc
