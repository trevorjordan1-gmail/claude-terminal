+  // Local patch: hide windows of these apps from the Alt+` list (matched
+  // case-insensitively as a substring of the window's WM_CLASS). RustDesk on
+  // this box is the custom "wtfappsrdlinux-tj" build; it is the remote-access
+  // console itself, never something to switch to.
+  const EXCLUDED_WM_CLASSES = ['wtfappsrdlinux', 'rustdesk'];
+  const isExcluded = function(win) {
+    const cls = (win.get_wm_class() || '').toLowerCase();
+    return EXCLUDED_WM_CLASSES.some(x => cls.includes(x));
+  };
+
